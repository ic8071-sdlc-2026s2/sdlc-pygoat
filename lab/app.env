# Datos de la app para lab/app.sh, los workflows y el verificador.
APP_NOMBRE="OWASP PyGoat"
APP_PUERTO=8000
APP_RUTA_SALUD="/login/"
APP_RUTA_INICIAL=""
# El código fija ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS sin el dominio de los puertos de Codespaces
# (*.app.github.dev): la app respondería 400 en el navegador del Codespace. APP_COMANDO escribe al
# arrancar pygoat/settings_lab.py, que importa pygoat/settings.py y solo agrega ese dominio.
APP_DOCKER_ARGS=(-e DJANGO_SETTINGS_MODULE=pygoat.settings_lab)
# Sin Traefik ni laboratorios en contenedores: solo la app Django con SQLite.
# seed_scoring, populate_labs y populate_challenges cargan dificultades, logros, el catálogo
# de laboratorios del menú lateral y el reto; sin ellos el menú queda vacío. No usan Docker.
APP_COMANDO=(sh -c 'printf "from pygoat.settings import *\nALLOWED_HOSTS += [\".app.github.dev\"]\nCSRF_TRUSTED_ORIGINS += [\"https://*.app.github.dev\"]\n" > pygoat/settings_lab.py && python manage.py migrate --noinput && python manage.py seed_scoring && python manage.py populate_labs && python manage.py populate_challenges && exec gunicorn --bind 0.0.0.0:8000 --workers 2 --threads 4 --timeout 120 pygoat.wsgi')
APP_IMAGEN_UPSTREAM=""
APP_ESPERA_SEGUNDOS=240
ZAP_MODO="baseline"
ZAP_OPENAPI=""
